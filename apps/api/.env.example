# --- server -----------------------------------------------------------------
PORT=4000
CLIENT_URL=http://localhost:5173
# Public base URL used in OpenAPI try-outs / payment return URLs.
PUBLIC_API_URL=http://localhost:4000
LOG_LEVEL=info
NODE_ENV=development

# --- supabase ---------------------------------------------------------------
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase project JWT secret (Settings → API) — verifies access tokens (HS256).
JWT_SECRET=dev-only-change-me-min-32-chars
# Optional dedicated secret for slip QR check-in tokens (defaults to JWT_SECRET).
CHECKIN_SECRET=

# --- rate limits (per minute, per IP) ---------------------------------------
RATE_WINDOW_MS=60000
RATE_MAX=120
RATE_BOOKING_MAX=30
RATE_STRICT_MAX=20
RATE_AI_MAX=6

# --- domain rules -----------------------------------------------------------
# Patient may cancel/reschedule up to N hours before the slot (staff exempt).
CANCEL_WINDOW_HOURS=2
NO_SHOW_GRACE_MINUTES=30
UNPAID_HOLD_HOURS=24

# --- cron -------------------------------------------------------------------
CRON_ENABLED=true

# --- notifications ----------------------------------------------------------
# Email via Resend (https://resend.com). Empty = log-only (dev).
RESEND_API_KEY=
EMAIL_FROM=MediNova <onboarding@resend.dev>
# BD SMS gateway stub (local dev): POST {to,text} with X-Api-Key header.
SMS_GATEWAY_URL=
SMS_API_KEY=
SMS_SENDER_ID=MediNova

# --- ai triage --------------------------------------------------------------
# heuristic (default, offline) | gemini | claude
AI_PROVIDER=heuristic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-latest

# --- storage ----------------------------------------------------------------
PRESCRIPTIONS_BUCKET=prescriptions

# --- payments ---------------------------------------------------------------
# Sandbox mode for bkash/nagad/sslcommerz adapters (cash needs nothing).
PAYMENT_SANDBOX=true
BKASH_SANDBOX_URL=https://sandbox.bka.sh/v1.2.0-beta/checkout/pay
BKASH_APP_KEY=
BKASH_SECRET=
NAGAD_SANDBOX_URL=https://sandbox.mynagad.com:8443/remote-payment-gateway-1.0/api/dfs
NAGAD_MERCHANT_ID=
NAGAD_SALT=
SSLCOMMERZ_SANDBOX_URL=https://sandbox.sslcommerz.com/gwprocess/v4/api.php
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_SALT=

